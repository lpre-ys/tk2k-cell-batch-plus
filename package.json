{
  "name": "tk2k-cell-batch-plus",
  "version": "1.0.2",
  "private": true,
  "main": "electron/electron.js",
  "license": "GPL",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check build-only",
    "clean": "rimraf dist",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "lint": "eslint . --fix",
    "lint:ci": "eslint .",
    "format": "prettier --write src/",
    "test": "vitest",
    "test:ci": "vitest run",
    "electron": "electron .",
    "electron-clean": "rimraf build",
    "electron-build": "electron-builder -w",
    "release": "run-s clean electron-clean build electron-build"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "tk2k-clipdata": "github:lpre-ys/tk2k-clipdata",
    "vue": "^3.5.40",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node18": "^18.2.6",
    "@tsconfig/node20": "^20.1.9",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  },
  "build": {
    "appId": "com.lpre-ys.cell-batch-plus",
    "productName": "CellBatchPlus",
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "extraFiles": [
      "README.md",
      "LICENSE"
    ],
    "asarUnpack": [
      "node_modules/tk2k-clipdata/"
    ],
    "directories": {
      "buildResources": "asset",
      "output": "build"
    },
    "win": {
      "icon": "asset/icon.ico",
      "target": "zip"
    }
  }
}
